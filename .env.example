# Copy to .env (git-ignored). Never commit real keys.

# Server
PORT=3001
LLM_PROVIDER=mock            # mock | anthropic
ANTHROPIC_API_KEY=           # only needed when LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-4-5
LOG_LEVEL=info
RATE_LIMIT_PER_MIN=20        # per client, LLM endpoints only
TRUST_PROXY=0                # number of reverse proxies in front (1 on Render)
STREAM_TIMEOUT_MS=30000
MOCK_TOKEN_DELAY_MS=25       # streaming speed of the mock provider
MOCK_ANALYSIS_DELAY_MS=400
